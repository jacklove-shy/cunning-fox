# ============ 数据库配置（MySQL / mysql2） ============
# 复制本文件为 .env 并按需修改。.env 已被 .gitignore 忽略，不会入库。
# 所有变量都有本地开发默认值（见 src/db.ts dbConfig()），不填也能跑（前提是你本地有同名 MySQL 实例）。

# 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portfolio
DB_PASSWORD=
DB_NAME=portfolio

# 连接池上限（个人站并发极低，10 足够；MySQL 默认 max_connections=151）
DB_POOL_LIMIT=10

# ============ 应用配置 ============
# 默认管理员初始密码（仅首次创建管理员时生效；之后改密码走「账户」页）
AUTH_ADMIN_PW=admin1234

# 服务端口 / 监听地址
PORT=3001
# HOST=127.0.0.1   # 仅本机；对外服务时设 0.0.0.0（务必先给工具接口加鉴权）

# 工具运行时（文件读写 / ffmpeg / 子进程）开关
# 留空 = 默认开（本地开发）；公开部署或隧道分享务必设 0，关闭 /api/toolkit 避免暴露本机文件系统
# ENABLE_TOOLKIT=0

